# Local demonstration credentials. The database port is not exposed to the host.
POSTGRES_PASSWORD=local-demo-password
APP_PORT=8000

# Optional local report explanations. Start Ollama and download the model once:
# docker compose --profile ai up -d --wait llm
# docker compose exec llm ollama pull qwen3:1.7b
LLM_BASE_URL=http://llm:11434
LLM_MODEL=qwen3:1.7b
LLM_TIMEOUT_SECONDS=120

